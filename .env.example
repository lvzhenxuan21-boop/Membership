APP_NAME="Membership Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum: 允许携带 web session cookie 调用 /api/*（前端 fetch 支付/mock-pay 依赖此配置）
# 生产环境设为你的域名，如 fenshen66.xyz
SANCTUM_STATEFUL_DOMAINS=localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── 支付 ── 通用 + 兼顾 Cashier(Stripe)
PAYMENT_DEFAULT_CHANNEL=mock
# Mock 渠道开关：留空=自动（非生产放行，生产禁用）；生产必须为 false 或留空
PAYMENT_MOCK_ENABLED=
PAYMENT_EXPIRE_MINUTES=30
PAYMENT_CURRENCY=CNY
PAYMENT_WALLET_ENABLED=true
# Stripe via Cashier (海外)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_PATH=stripe
# 微信 (yansongda/pay)
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_KEY=
WECHAT_PAY_APP_ID=
# 支付宝 (yansongda/pay)
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
MEMBERSHIP_DEMO_STORE_URL=

# ── 商户与运营开关 ──
# 自助开店是否自动激活：生产建议 false（开店后置 pending，由平台在后台审核激活）
MEMBERSHIP_TENANT_AUTO_ACTIVATE=true
# 裸域访问 /pricing /me 等页面的兜底商户 slug
MEMBERSHIP_DEFAULT_TENANT_SLUG=demo
# 单用户最多同时存在的未支付订单数（pending 锁库存，防刷单；0=不限制）
MEMBERSHIP_MAX_PENDING_ORDERS=5

# 反向代理信任列表：* 或逗号分隔 IP/CIDR；nginx/CDN 后必须设置，直连部署请留空
TRUSTED_PROXIES=
